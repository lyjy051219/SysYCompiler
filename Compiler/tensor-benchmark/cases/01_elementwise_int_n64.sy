int main() {
  tensor int a[64];
  tensor int b[64];
  tensor int c[64];
  int seed = getint();
  int rounds = getint();
  int i = 0;
  while (i < 64) {
    a[i] = i % 7 + seed;
    b[i] = i % 3 - 1;
    i = i + 1;
  }

  starttime();
  int round = 0;
  while (round < rounds) {
    c = a + b;
    a = c - 1;
    round = round + 1;
  }
  stoptime();

  int checksum = 0;
  i = 0;
  while (i < 64) {
    checksum = checksum + a[i] * (i % 5 + 1);
    i = i + 1;
  }
  putint(checksum);
  putch(10);
  return 0;
}
