tensor int add_bias(tensor int source[], int bias) {
  return source + bias;
}

tensor int copy_value(tensor int source[]) {
  return source;
}

int main() {
  tensor int a[64];
  tensor int b[64];
  int seed = getint();
  int bias = getint();
  int rounds = getint();
  int i = 0;
  while (i < 64) {
    a[i] = i % 13 + seed;
    i = i + 1;
  }

  starttime();
  int round = 0;
  while (round < rounds) {
    b = add_bias(a, bias);
    a = copy_value(b);
    round = round + 1;
  }
  stoptime();

  int checksum = 0;
  i = 0;
  while (i < 64) {
    checksum = checksum + a[i] * (i % 7 + 1);
    i = i + 1;
  }
  putint(checksum);
  putch(10);
  return 0;
}
