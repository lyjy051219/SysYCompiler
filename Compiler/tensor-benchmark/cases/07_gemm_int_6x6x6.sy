int main() {
  tensor int left[6][6];
  tensor int right[6][6];
  tensor int answer[6][6];
  int seed = getint();
  int rounds = getint();
  int i = 0;
  while (i < 6) {
    int j = 0;
    while (j < 6) {
      left[i][j] = (i + j) % 5 + seed;
      right[i][j] = (i * 2 + j) % 4 - 1;
      j = j + 1;
    }
    i = i + 1;
  }

  starttime();
  int round = 0;
  int checksum = 0;
  while (round < rounds) {
    int changed_row = round % 6;
    int changed_column = (round / 6) % 6;
    left[changed_row][changed_column] = left[changed_row][changed_column] + 1;
    answer = left @ right;
    checksum = checksum + answer[changed_row][changed_column];
    round = round + 1;
  }
  stoptime();

  putint(checksum);
  putch(10);
  return 0;
}
