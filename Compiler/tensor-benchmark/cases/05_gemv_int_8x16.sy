int main() {
  tensor int matrix[8][16];
  tensor int column[16];
  tensor int answer[8];
  int seed = getint();
  int rounds = getint();
  int i = 0;
  while (i < 8) {
    int j = 0;
    while (j < 16) {
      matrix[i][j] = (i * 3 + j) % 5 - 2;
      j = j + 1;
    }
    i = i + 1;
  }
  i = 0;
  while (i < 16) {
    column[i] = i % 7 + seed;
    i = i + 1;
  }

  starttime();
  int round = 0;
  int checksum = 0;
  while (round < rounds) {
    int changed = round % 16;
    column[changed] = column[changed] + 1;
    answer = matrix @ column;
    checksum = checksum + answer[round % 8];
    round = round + 1;
  }
  stoptime();

  putint(checksum);
  putch(10);
  return 0;
}
